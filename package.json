{
  "name": "eterna-ide",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.2.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "start": "node scripts/prepare-pty.mjs && node server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "tsc --noEmit",
    "postinstall": "node scripts/prepare-pty.mjs",
    "launch": "node scripts/launch.mjs",
    "test:e2e": "playwright test",
    "benchmark": "node scripts/benchmark.mjs",
    "desktop:ui": "vite --port 1420 --strictPort",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "test:native": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:synapse": "node --experimental-strip-types --test src/synapse-layout.test.mjs"
  },
  "dependencies": {
    "@codemirror/lang-javascript": "^6.2.4",
    "@codemirror/lang-markdown": "^6.3.3",
    "@codemirror/lang-python": "^6.2.1",
    "@openai/codex": "^0.163.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "@uiw/react-codemirror": "^4.25.3",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "diff": "^8.0.0",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "node-pty": "^1.1.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.186.1",
    "ws": "^8.18.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@tauri-apps/cli": "^2.12.3",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^4.4.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0"
  },
  "description": "A local AI IDE with shared knowledge, evidence-aware memory, and official coding-agent terminals.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/EternaxCode/eterna-ide.git"
  }
}
